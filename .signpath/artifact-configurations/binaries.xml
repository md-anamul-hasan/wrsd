<?xml version="1.0" encoding="utf-8"?>
<!-- WRSD's own executables; the .NET runtime bundled in them is third-party and is not signed by us. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Wrsd*.exe" />
      <include path="wrsd-cli.exe" />
      <authenticode-sign />
    </pe-file-set>
  </zip-file>
</artifact-configuration>
