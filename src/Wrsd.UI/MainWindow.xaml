<Window x:Class="Wrsd.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wrsd.UI"
        xmlns:ctrl="clr-namespace:Wrsd.UI.Controls"
        xmlns:vm="clr-namespace:Wrsd.UI.ViewModels"
        mc:Ignorable="d"
        Title="WRSD — Windows Registry Snapshot Diff"
        Icon="Assets/app_icon.ico"
        Height="840" Width="1320"
        MinHeight="660" MinWidth="1060"
        Background="{DynamicResource BrushBg}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="B" Command="{Binding TakeBaselineCommand}" />
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding TakeTargetAndDiffCommand}" />
        <KeyBinding Modifiers="Control" Key="R" Command="{Binding ResetCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding ExportUndoRegCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveBaselineCommand}" />
        <KeyBinding Key="F5" Command="{Binding TakeTargetAndDiffCommand}" />
    </Window.InputBindings>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ctrl:TitleBar Grid.Row="0"/>

    <Grid Grid.Row="1" x:Name="Body">
        <Grid.ColumnDefinitions>
            <!-- 0: Fluent Enterprise Sidebar -->
            <ColumnDefinition Width="220" />
            <!-- 1: Main Workspace Content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================= -->
        <!-- 0. FLUENT ENTERPRISE SIDEBAR                              -->
        <!-- ========================================================= -->
        <Border Grid.Column="0" Background="{DynamicResource BrushSidebarBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand -->
                    <RowDefinition Height="Auto" />
                    <!-- Navigation Tabs -->
                    <RowDefinition Height="*" />
                    <!-- Footer: Theme and links -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Padding="18,18,18,14" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="/Assets/app_icon.png" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="WRSD" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Background="{DynamicResource BrushPrimarySubtle}" BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="1" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                    <TextBlock Text="MIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Registry Snapshot Diff" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Tabs -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,14">
                    <StackPanel>
                        <!-- 1. Diff Inspector Tab -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SwitchNavTabCommand}" CommandParameter="DiffInspector" Margin="0,0,0,4">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDiffInspectorActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushSidebarSelected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeomCompare}" Fill="{DynamicResource BrushPrimary}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Diff Inspector" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushText}" />
                                    <TextBlock Text="Snapshot &amp; comparison" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- 2. Snapshot Vault Tab -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SwitchNavTabCommand}" CommandParameter="SnapshotVault" Margin="0,0,0,4">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSnapshotVaultActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushSidebarSelected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeomFolder}" Fill="{DynamicResource BrushAccentCyan}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Snapshot Vault" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushText}" />
                                    <TextBlock Text="Browse &amp; compare history" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- 3. Threat Hunter Tab -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SwitchNavTabCommand}" CommandParameter="ThreatHunter" Margin="0,0,0,4">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThreatHunterActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushSidebarSelected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeomShield}" Fill="{DynamicResource BrushViolet}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Threat Hunter" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushText}" />
                                    <TextBlock Text="MITRE ATT&amp;CK persistence" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>
                                <!-- Threat count badge -->
                                <Border Grid.Column="2" Visibility="{Binding TotalThreatsCount, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushDangerSubtle}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalThreatsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushDanger}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- 4. SIEM & Reports Tab -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SwitchNavTabCommand}" CommandParameter="SiemReports" Margin="0,0,0,4">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSiemReportsActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushSidebarSelected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeomReport}" Fill="{DynamicResource BrushWarning}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="SIEM &amp; Reports" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushText}" />
                                    <TextBlock Text="CSV, HTML, JSON, .reg" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- 5. Settings & Rules Tab -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SwitchNavTabCommand}" CommandParameter="SettingsRules" Margin="0,0,0,4">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsRulesActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushSidebarSelected}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeomSettings}" Fill="{DynamicResource BrushTextMuted}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Settings &amp; Rules" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource BrushText}" />
                                    <TextBlock Text="Theme, presets, about" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: Theme switcher and project link -->
                <Border Grid.Row="2" Padding="12,12" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Theme Toggle Button -->
                        <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding ToggleThemeCommand}" Height="34" Margin="0,0,0,8" Padding="10,0" ToolTip="{Binding ThemeTooltipText}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{Binding ThemeIconGeometry}" Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ThemeLabelText, StringFormat='Theme: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="⇄" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <!-- Open source link -->
                        <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding OpenRepositoryCommand}" Height="34" Padding="10,0" ToolTip="Open the project on GitHub">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource GeomShield}" Fill="{DynamicResource BrushPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Free and open source (MIT)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- 1. MAIN WORKSPACE / TAB CONTENT AREA                      -->
        <!-- ========================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Enterprise Action / Control Bar -->
                <RowDefinition Height="Auto" />
                <!-- Active Viewport Body -->
                <RowDefinition Height="*" />
                <!-- Bottom Status Bar -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Header Control Bar -->
            <Border Grid.Row="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="18,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Active Tab Breadcrumb / Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="WRSD" FontSize="13" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="/" FontSize="13" Foreground="{DynamicResource BrushBorder}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Diff Inspector" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                                   Visibility="{Binding IsDiffInspectorActive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Snapshot Vault" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                                   Visibility="{Binding IsSnapshotVaultActive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Threat Hunter (MITRE ATT&amp;CK)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                                   Visibility="{Binding IsThreatHunterActive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="SIEM &amp; Audit Reports" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                                   Visibility="{Binding IsSiemReportsActive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Settings &amp; Rules" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"
                                   Visibility="{Binding IsSettingsRulesActive, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Preset Scope Selector & Workflow Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Scope:" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Width="140" Height="32" Margin="0,0,8,0" ToolTip="Select snapshot scan scope" />
                        <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding ResetCommand}" Height="32" Padding="12,0" ToolTip="Reset session (Ctrl+R)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeomReset}" Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Reset" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================================================== -->
            <!-- TAB 1: DIFF INSPECTOR (Primary Workflow)              -->
            <!-- ===================================================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsDiffInspectorActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <!-- Stepper Action Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Filter, Search & Stats Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Diff Results Workspace -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Stepper Action Bar -->
                <Border Grid.Row="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Step 1: Baseline -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding TakeBaselineCommand}" Height="32" Padding="14,0" ToolTip="Capture before snapshot (Ctrl+B)" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomBaseline}" Fill="{DynamicResource BrushOnPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Baseline" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding LoadBaselineCommand}" Height="32" Width="32" Padding="0" ToolTip="Load baseline .wrsd file" Margin="0,0,4,0">
                                <Path Data="{StaticResource GeomFolder}" Fill="{DynamicResource BrushTextMuted}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding SaveBaselineCommand}" Height="32" Width="32" Padding="0" ToolTip="Save baseline .wrsd file (Ctrl+S)" Margin="0,0,8,0">
                                <Path Data="{StaticResource GeomSave}" Fill="{DynamicResource BrushTextMuted}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Border Visibility="{Binding HasBaseline, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushPrimarySubtle}" BorderBrush="{DynamicResource BrushPrimary}" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BaselineBadgeText, StringFormat='✓ {0}'}" Foreground="{DynamicResource BrushPrimary}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Arrow -->
                        <TextBlock Grid.Column="1" Text="→" FontSize="16" VerticalAlignment="Center" Margin="8,0,16,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBaseline}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushAccentCyan}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Step 2: Action Phase -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Height="32" Padding="10,0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomTimer}" Fill="{DynamicResource BrushAccentCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ElapsedActionTime}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentCyan}" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding LaunchInstallerCommand}" Height="32" Padding="14,0" ToolTip="Launch installer (.exe, .msi) to track">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomRocket}" Fill="{DynamicResource BrushAccentCyan}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Launch App..." Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Arrow -->
                        <TextBlock Grid.Column="3" Text="→" FontSize="16" VerticalAlignment="Center" Margin="16,0,16,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBaseline}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Step 3: Compare Diff -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding TakeTargetAndDiffCommand}" Height="32" Padding="14,0" ToolTip="Capture target snapshot and diff (Ctrl+D / F5)" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomCompare}" Fill="{DynamicResource BrushOnPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Compare Diff" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding LoadTargetAndDiffCommand}" Height="32" Width="32" Padding="0" ToolTip="Load target .wrsd file and diff" Margin="0,0,4,0">
                                <Path Data="{StaticResource GeomFolder}" Fill="{DynamicResource BrushTextMuted}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding SaveTargetCommand}" Height="32" Width="32" Padding="0" ToolTip="Save target .wrsd file" Margin="0,0,8,0">
                                <Path Data="{StaticResource GeomSave}" Fill="{DynamicResource BrushTextMuted}" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Border Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushWarningSubtle}" BorderBrush="{DynamicResource BrushWarning}" BorderThickness="1" CornerRadius="6" Height="32" Padding="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TargetBadgeText, StringFormat='✓ {0}'}" Foreground="{DynamicResource BrushWarning}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter & Search Bar -->
                <Border Grid.Row="1" Background="{DynamicResource BrushBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Filter Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Background="{DynamicResource BrushBadgeBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Height="26" Padding="8,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalChanges, StringFormat='{}{0} changed'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
                            </Border>

                            <Button Content="All" Command="{Binding SetFilterAllCommand}" Margin="0,0,4,0" ToolTip="Show all changes">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushButtonOutlineHover}" />
                                                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonOutlineBorderHover}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{Binding AddedKeysCount, StringFormat='+{0}'}" Command="{Binding SetFilterAddedCommand}" Margin="0,0,4,0" ToolTip="Show Added only">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAdded}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{Binding ModifiedKeysCount, StringFormat='~{0}'}" Command="{Binding SetFilterModifiedCommand}" Margin="0,0,4,0" ToolTip="Show Modified only">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterModified}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushWarningSubtle}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{Binding DeletedKeysCount, StringFormat='-{0}'}" Command="{Binding SetFilterDeletedCommand}" Margin="0,0,8,0" ToolTip="Show Deleted only">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterPillStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterDeleted}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushDangerSubtle}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Border Visibility="{Binding PersistenceRisksCount, Converter={StaticResource BoolToVis}}" Background="{DynamicResource BrushVioletSubtle}" BorderBrush="{DynamicResource BrushViolet}" BorderThickness="1" CornerRadius="6" Height="26" Padding="8,0" Margin="0,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PersistenceRisksCount, StringFormat='! {0} autorun'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushViolet}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Search Input -->
                        <Grid Grid.Column="1" HorizontalAlignment="Left" Width="200" Height="28" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="8,0,24,0" VerticalContentAlignment="Center" ToolTip="Filter keys, values, or data" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSearchText}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Path Data="{StaticResource GeomSearch}" Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Search keys or data..." Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Command="{Binding ClearSearchCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSearchText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Data="{StaticResource GeomClear}" Fill="{DynamicResource BrushTextMuted}" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <!-- Right Toggles & View Mode Switcher -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="Hide Noise" IsChecked="{Binding HideNoise}" Margin="0,0,12,0" ToolTip="Filter out dynamic Windows background churn" />
                            <CheckBox Content="Autoruns Only" IsChecked="{Binding PersistenceOnly}" Foreground="{DynamicResource BrushViolet}" FontWeight="SemiBold" Margin="0,0,14,0" ToolTip="Highlight persistence hooks and autoruns" />

                            <!-- Side-by-Side View Toggle Button -->
                            <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding ToggleSideBySideViewCommand}" Height="28" Padding="10,0" VerticalAlignment="Center" ToolTip="Toggle Side-by-Side Value Inspector">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomSplit}" Fill="{DynamicResource BrushAccentCyan}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Foreground="{DynamicResource BrushText}" FontSize="11" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Side-by-side: off" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSideBySideView}" Value="True">
                                                        <Setter Property="Text" Value="Side-by-side: on" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Diff Results Main Workspace -->
                <Grid Grid.Row="2">
                    <!-- Empty State -->
                    <Border Visibility="{Binding HasNoDiff, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="/Assets/app_icon.png" Width="64" Height="64" Margin="0,0,0,16" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Ready to analyze registry changes" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="Click 'Baseline' to snapshot current state, run your software, then click 'Compare Diff'." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Splitter Workspace -->
                    <Grid Visibility="{Binding HasDiff, Converter={StaticResource BoolToVis}}" Margin="16,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" MinWidth="260" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" MinWidth="380" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Pane: Keys List -->
                        <Border Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="Keys" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" />
                                        <TextBlock Text="{Binding FilteredCount, StringFormat='{}{0} found'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredKeys}" SelectedItem="{Binding SelectedKey}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.CanContentScroll="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel">
                                    <ListBox.ContextMenu>
                                        <ContextMenu Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}">
                                            <MenuItem Header="Open in Regedit" Command="{Binding OpenInRegeditCommand}" Foreground="{DynamicResource BrushText}" />
                                            <MenuItem Header="Copy Key Path" Command="{Binding CopyKeyPathCommand}" Foreground="{DynamicResource BrushText}" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:KeyDiffViewModel}">
                                            <Grid Margin="0,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Border CornerRadius="3" Padding="5,1" Margin="0,0,6,0"
                                                            Background="{Binding BadgeColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.15}">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{Binding BadgeColor, Converter={StaticResource HexToBrush}}" />
                                                    </Border>
                                                    <Border Visibility="{Binding IsPersistenceRisk, Converter={StaticResource BoolToVis}}"
                                                            CornerRadius="3" Padding="5,1" Background="{DynamicResource BrushVioletSubtle}">
                                                        <TextBlock Text="{Binding RiskCategory}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushViolet}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding KeyPath}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Grid.Row="1" Text="No matching keys found"
                                           Visibility="{Binding HasNoFilteredResults, Converter={StaticResource BoolToVis}}"
                                           Foreground="{DynamicResource BrushTextMuted}" FontStyle="Italic" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" Cursor="SizeWE" />

                        <!-- Right Pane: Values Inspector -->
                        <Border Grid.Column="2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedKey.KeyPath, TargetNullValue='No key selected'}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource BrushText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource SmallOutlineButtonStyle}" Command="{Binding CopyKeyPathCommand}" Height="26" Padding="8,0" Margin="0,0,4,0" ToolTip="Copy registry path">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeomCopy}" Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Copy" Foreground="{DynamicResource BrushText}" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{DynamicResource SmallOutlineButtonStyle}" Command="{Binding OpenInRegeditCommand}" Height="26" Padding="8,0" ToolTip="Open key in Regedit">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource GeomRegedit}" Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Regedit" Foreground="{DynamicResource BrushText}" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1" Text="No values stored under this key (container key)"
                                           Visibility="{Binding HasNoSelectedKeyValues, Converter={StaticResource BoolToVis}}"
                                           Foreground="{DynamicResource BrushTextMuted}" FontStyle="Italic" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- View Mode A: Standard DataGrid -->
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedKey.Values}"
                                          Visibility="{Binding HasSelectedKeyValues, Converter={StaticResource BoolToVis}}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          EnableRowVirtualization="True"
                                          Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BrushGridLine}" HeadersVisibility="Column" RowBackground="Transparent">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}">
                                            <MenuItem Header="Copy Value Name" Command="{Binding CopyValueNameCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" Foreground="{DynamicResource BrushText}" />
                                            <MenuItem Header="Copy Before Value" Command="{Binding CopyBeforeValueCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" Foreground="{DynamicResource BrushText}" />
                                            <MenuItem Header="Copy After Value" Command="{Binding CopyAfterValueCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" Foreground="{DynamicResource BrushText}" />
                                            <Separator Background="{DynamicResource BrushBorder}" />
                                            <MenuItem Header="Copy Row Details" Command="{Binding CopyFullRowCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu}, Path=PlacementTarget.SelectedItem}" Foreground="{DynamicResource BrushText}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}" />
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushListItemHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource BrushListItemSelected}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Value Name" Binding="{Binding ValueName}" Width="150" FontFamily="{StaticResource MonoFont}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="100" FontFamily="{StaticResource MonoFont}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="Change" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="{x:Type vm:ValueDiffViewModel}">
                                                    <Border CornerRadius="3" Padding="5,1" HorizontalAlignment="Left"
                                                            Background="{Binding BadgeColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.15}">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{Binding BadgeColor, Converter={StaticResource HexToBrush}}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Before (Baseline)" Binding="{Binding BeforeDisplay}" Width="*" FontFamily="{StaticResource MonoFont}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="After (Target)" Binding="{Binding AfterDisplay}" Width="*" FontFamily="{StaticResource MonoFont}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ===================================================== -->
            <!-- TAB 2: SNAPSHOT VAULT (Historical Management)         -->
            <!-- ===================================================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsSnapshotVaultActive, Converter={StaticResource BoolToVis}}" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Vault Header Action Bar -->
                <Border Grid.Row="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Snapshot Repository Vault" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushText}" />
                            <TextBlock Text="Stored in Documents\WRSD\Snapshots — Select any two snapshots to run historical comparisons." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding RefreshVaultCommand}" Height="32" Margin="0,0,8,0" Padding="12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomReset}" Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh Vault" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ImportSnapshotToVaultCommand}" Height="32" Padding="14,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource GeomFolder}" Fill="{DynamicResource BrushOnPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Import .wrsd" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Vault Snapshots Grid -->
                <Border Grid.Row="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8">
                    <DataGrid ItemsSource="{Binding VaultSnapshots}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BrushGridLine}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FontSize" Value="11" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Snapshot File" Binding="{Binding FileName}" Width="280" FontFamily="{StaticResource MonoFont}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Captured Date" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160" />
                            <DataGridTextColumn Header="File Size" Binding="{Binding FileSizeBytes}" Width="100" />
                            <DataGridTextColumn Header="Scope" Binding="{Binding ScopePreset}" Width="140" />
                            <DataGridTextColumn Header="Full Path" Binding="{Binding FilePath}" Width="*" FontFamily="{StaticResource MonoFont}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Compare Dual Snapshots Selector -->
                <Border Grid.Row="2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Snapshot A -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Snapshot A (Baseline):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding VaultSnapshots}" SelectedItem="{Binding SelectedVaultSnapshotA}" DisplayMemberPath="FileName" Height="32" />
                        </StackPanel>

                        <!-- VS Divider -->
                        <TextBlock Grid.Column="1" Text="VS" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAccentCyan}" VerticalAlignment="Center" Margin="16,14,16,0" />

                        <!-- Snapshot B -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Snapshot B (Target):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding VaultSnapshots}" SelectedItem="{Binding SelectedVaultSnapshotB}" DisplayMemberPath="FileName" Height="32" />
                        </StackPanel>

                        <!-- Action Button -->
                        <Button Grid.Column="3" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding CompareSelectedVaultSnapshotsCommand}" Height="32" VerticalAlignment="Bottom" Margin="16,0,0,0" Padding="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeomCompare}" Fill="{DynamicResource BrushOnPrimary}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Compare Diff Now" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- TAB 3: THREAT HUNTER (MITRE ATT&CK Triage)            -->
            <!-- ===================================================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsThreatHunterActive, Converter={StaticResource BoolToVis}}" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Threat Metrics & Actions Header -->
                <Border Grid.Row="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BrushVioletSubtle}" BorderBrush="{DynamicResource BrushViolet}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Total Persistence Risks" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushViolet}" />
                                    <TextBlock Text="{Binding TotalThreatsCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushViolet}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushDangerSubtle}" BorderBrush="{DynamicResource BrushDanger}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Critical / High Severity" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushDanger}" />
                                    <TextBlock Text="{Binding CriticalThreatsCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushDanger}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="MITRE ATT&amp;CK Triage Engine" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushText}" />
                                <TextBlock Text="Scans autoruns, service installations, debugger hijacks (IFEO), and winlogon shell hooks." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Remediation Action -->
                        <Button Grid.Column="1" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ExportThreatRollbackRegCommand}" Height="34" VerticalAlignment="Center" Padding="16,0" ToolTip="Export .reg script to neutralize all detected persistence hooks">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeomUndo}" Fill="{DynamicResource BrushOnPrimary}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Export Remediation .reg" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Threat Findings List -->
                <Border Grid.Row="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <DataGrid ItemsSource="{Binding ThreatItems}" SelectedItem="{Binding SelectedThreatItem}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BrushGridLine}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}" />
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="Padding" Value="12,8" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Severity" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:ThreatItemViewModel}">
                                            <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Left"
                                                    Background="{Binding SeverityColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.18}">
                                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding SeverityColor, Converter={StaticResource HexToBrush}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="MITRE ATT&amp;CK Technique" Binding="{Binding MitreAttackId}" Width="280">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource BrushViolet}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Risk Classification" Binding="{Binding RiskCategory}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Compromised Registry Key" Binding="{Binding KeyPath}" Width="*" FontFamily="{StaticResource MonoFont}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty State when clean -->
                        <TextBlock Text="No persistence or autorun hooks detected in current comparison."
                                   Foreground="{DynamicResource BrushTextMuted}" FontStyle="Italic" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalThreatsCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================================================== -->
            <!-- TAB 4: SIEM & REPORTS                                 -->
            <!-- ===================================================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsSiemReportsActive, Converter={StaticResource BoolToVis}}" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Audit Metrics Cards -->
                        <TextBlock Text="Executive Audit Summary" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL KEYS CHANGED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextMuted}" />
                                    <TextBlock Text="{Binding TotalChanges}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushText}" Margin="0,4,0,0" />
                                    <TextBlock Text="Registry nodes modified" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="VALUES ADDED / MODIFIED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" />
                                    <TextBlock Text="{Binding TotalValuesChanged}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,4,0,0" />
                                    <TextBlock Text="Individual data entries" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="PERSISTENCE RISKS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushViolet}" />
                                    <TextBlock Text="{Binding PersistenceRisksCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushViolet}" Margin="0,4,0,0" />
                                    <TextBlock Text="Autoruns &amp; service hooks" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="NOISE SUPPRESSED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" />
                                    <TextBlock Text="{Binding NoiseKeysCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushAccentCyan}" Margin="0,4,0,0" />
                                    <TextBlock Text="OS telemetry filtered" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Enterprise Export Center -->
                        <TextBlock Text="Multi-Format Exports" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,12" />

                        <!-- Export Options Grid -->
                        <Grid Margin="0,0,0,24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1. CSV Export Tile -->
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="CSV Spreadsheet Export (SIEM Ingestion)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushText}" />
                                        <TextBlock Text="Formatted for Splunk, Microsoft Sentinel, Elastic SIEM, and Microsoft Excel." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ExportCsvCommand}" Height="32" VerticalAlignment="Center" Padding="14,0" Margin="12,0,0,0">
                                        <TextBlock Text="Export CSV" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 2. HTML Report Tile -->
                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Interactive HTML Audit Report" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushText}" />
                                        <TextBlock Text="Self-contained styled HTML document with expandable nodes and summary cards." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{DynamicResource OutlineButtonStyle}" Command="{Binding ExportHtmlCommand}" Height="32" VerticalAlignment="Center" Padding="14,0" Margin="12,0,0,0">
                                        <TextBlock Text="Export HTML" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 3. JSON Export Tile -->
                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Machine-Readable JSON Schema" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushText}" />
                                        <TextBlock Text="Complete raw diff data structure for CI/CD automated validation and analysis." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{DynamicResource OutlineButtonStyle}" Command="{Binding ExportJsonCommand}" Height="32" VerticalAlignment="Center" Padding="14,0" Margin="12,0,0,0">
                                        <TextBlock Text="Export JSON" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- 4. Rollback .reg Script Tile -->
                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Rollback &amp; Apply (.reg) Scripts" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushText}" />
                                        <TextBlock Text="Native Windows registry scripts to 1-click restore or replicate system state." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding ExportUndoRegCommand}" Height="32" Padding="12,0" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="Rollback .reg" Foreground="{DynamicResource BrushDanger}" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Style="{DynamicResource OutlineButtonStyle}" Command="{Binding ExportRedoRegCommand}" Height="32" Padding="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Apply .reg" Foreground="{DynamicResource BrushPrimary}" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================== -->
            <!-- TAB 5: SETTINGS & RULES                               -->
            <!-- ===================================================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsSettingsRulesActive, Converter={StaticResource BoolToVis}}" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="1240" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                        <!-- Appearance Section -->
                        <TextBlock Text="Appearance &amp; Theme" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,12" />
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Select Application Theme" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushText}" />
                                <TextBlock TextWrapping="Wrap" Text="WRSD can follow your Windows OS light/dark personalization setting automatically or stay fixed." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <!-- System Default Button -->
                                    <Button Command="{Binding SetThemeSystemCommand}" Height="34" Margin="0,0,10,0" Padding="16,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThemeSystem}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeomMonitor}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThemeSystem}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushPrimary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="System Default (Auto)" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThemeSystem}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <!-- Dark Mode Button -->
                                    <Button Command="{Binding SetThemeDarkCommand}" Height="34" Margin="0,0,10,0" Padding="16,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThemeDark}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeomMoon}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThemeDark}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushPrimary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="Dark Mode" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThemeDark}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>

                                    <!-- Light Mode Button -->
                                    <Button Command="{Binding SetThemeLightCommand}" Height="34" Padding="16,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThemeLight}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BrushPrimarySubtle}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource GeomSun}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{DynamicResource BrushTextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThemeLight}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource BrushPrimary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="Light Mode" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsThemeLight}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Noise Suppression Rules -->
                        <TextBlock Text="Noise Suppression Rules" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,12" />
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Built-in filters (always on)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushText}" />
                                <TextBlock TextWrapping="Wrap" Text="These filters hide Windows background churn so the diff shows genuine installer changes. They cannot be switched off in v2.0." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,14" />
                                <CheckBox Content="Filter Windows Telemetry &amp; DiagTrack churn" IsChecked="True" IsEnabled="False" Margin="0,0,0,10" />
                                <CheckBox Content="Filter Windows Search Indexer &amp; UserAssist MRU keys" IsChecked="True" IsEnabled="False" Margin="0,0,0,10" />
                                <CheckBox Content="Filter Cryptography Certificate caches and CRL updates" IsChecked="True" IsEnabled="False" />
                            </StackPanel>
                        </Border>

                        </StackPanel>
                        <StackPanel Grid.Column="2">
                        <!-- Scan presets -->
                        <TextBlock Text="Scan presets" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,12" />
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Which part of the registry is captured" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushText}" />
                                <TextBlock Text="The choice is used by every snapshot you take. The same selector is in the top bar." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,14" />
                                <ItemsControl ItemsSource="{Binding PresetOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton GroupName="ScanPreset" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,12" Cursor="Hand">
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushText}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Command-line tool -->
                        <TextBlock Text="Command-line tool" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,12" />
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="wrsd-cli.exe for scripts and pipelines" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushText}" />
                                    <TextBlock Text="{Binding CliRuntimeStatus}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{DynamicResource PrimaryButtonStyle}" Content="Install .NET 10 runtime" Command="{Binding InstallCliRuntimeCommand}"
                                        Visibility="{Binding IsCliRuntimeMissing, Converter={StaticResource BoolToVis}}" Height="34" Padding="14,0" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- About -->
                        <TextBlock Text="About" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,12" />
                        <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="WRSD is free and open source (MIT)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushText}" />
                                <TextBlock TextWrapping="Wrap" Text="It makes no network connections: nothing is sent anywhere, and there is no account, licence key or telemetry." FontSize="12" Foreground="{DynamicResource BrushTextMuted}" Margin="0,6,0,12" />
                                <Button Style="{DynamicResource PrimaryButtonStyle}" Content="Project on GitHub" Command="{Binding OpenRepositoryCommand}" Height="34" Padding="18,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ===================================================== -->
            <!-- BOTTOM STATUS BAR                                     -->
            <!-- ===================================================== -->
            <Border Grid.Row="2" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Padding="18,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScanProgressText}" FontSize="11" Foreground="{DynamicResource BrushAccentCyan}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="{Binding IsScanning}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                     Width="100" Height="3" Foreground="{DynamicResource BrushPrimary}"
                                     Background="{DynamicResource BrushProgressTrack}" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{DynamicResource SmallOutlineButtonStyle}" Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                Height="24" Padding="8,0" VerticalAlignment="Center" ToolTip="Cancel active registry scan">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource GeomCancel}" Fill="{DynamicResource BrushDanger}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="Cancel" FontSize="11" Foreground="{DynamicResource BrushDanger}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{x:Static local:AppInfo.Label}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
    </Grid>
</Window>
