<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- WRSD light theme: same accent family as the dark theme; typography and radii come from the shared design tokens -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DesignTokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Color x:Key="ColorBg">#F4F6FA</Color>
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorCardHover">#E8EDF5</Color>
    <Color x:Key="ColorBorder">#E3E8F0</Color>
    <Color x:Key="ColorText">#0F172A</Color>
    <Color x:Key="ColorTextMuted">#6B7A90</Color>
    <Color x:Key="ColorPrimary">#2563EB</Color>
    <Color x:Key="ColorPrimaryHover">#1D4FD8</Color>
    <Color x:Key="ColorSecondary">#16A34A</Color>
    <Color x:Key="ColorAccentCyan">#2563EB</Color>
    <Color x:Key="ColorDanger">#DC2626</Color>
    <Color x:Key="ColorWarning">#D97706</Color>
    <Color x:Key="ColorViolet">#7C3AED</Color>

    <!-- SolidColorBrushes for Light Theme -->
    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColorCardHover}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="BrushPrimarySubtle" Color="#E0EAFF" />
    <SolidColorBrush x:Key="BrushOnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushSecondary" Color="{StaticResource ColorSecondary}" />
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerSubtle" Color="#FEE2E2" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushWarningSubtle" Color="#FEF3C7" />
    <SolidColorBrush x:Key="BrushViolet" Color="{StaticResource ColorViolet}" />
    <SolidColorBrush x:Key="BrushVioletSubtle" Color="#EDE9FE" />

    <!-- UI Surface & Control Brushes -->
    <SolidColorBrush x:Key="BrushInputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushGridLine" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BrushModalOverlay" Color="#80000000" />
    <SolidColorBrush x:Key="BrushButtonOutlineBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushButtonOutlineHover" Color="#E8EDF5" />
    <SolidColorBrush x:Key="BrushButtonOutlineBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushButtonOutlineBorderHover" Color="#C5CEDB" />
    <SolidColorBrush x:Key="BrushBadgeBg" Color="#F3F4F6" />
    <SolidColorBrush x:Key="BrushListItemHover" Color="#F3F4F6" />
    <SolidColorBrush x:Key="BrushListItemSelected" Color="#E6EEFF" />
    <SolidColorBrush x:Key="BrushToolTipBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushHeaderBg" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BrushPopupBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushProgressTrack" Color="#E5E7EB" />

    <!-- Enterprise V2 Sidebar & Surface Tokens -->
    <SolidColorBrush x:Key="BrushSidebarBg" Color="#EDF0F6" />
    <SolidColorBrush x:Key="BrushSidebarHover" Color="#E8EDF5" />
    <SolidColorBrush x:Key="BrushSidebarSelected" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushSidebarText" Color="#64748B" />
    <SolidColorBrush x:Key="BrushSidebarTextSelected" Color="#0F172A" />
    <SolidColorBrush x:Key="BrushCodeBg" Color="#F8FAFC" />

    <!-- Shared control tokens in the light palette: the shared Windows 11 controls (Win11Controls.xaml) read these keys -->
    <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource ColorBg}" />
    <SolidColorBrush x:Key="SurfaceOverlay" Color="#EDF0F6" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceInteractive" Color="{StaticResource ColorCardHover}" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#E6EEFF" />
    <SolidColorBrush x:Key="SurfaceBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="SurfaceBorderStrong" Color="#C5CEDB" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource ColorText}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource ColorTextMuted}" />
    <SolidColorBrush x:Key="TextTertiary" Color="#8C959F" />
    <SolidColorBrush x:Key="TextInverse" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="AccentPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="AccentPrimaryMuted" Color="#150E7490" />

</ResourceDictionary>
